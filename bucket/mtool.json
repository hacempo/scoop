{
    "version": "90DDB71A",
    "description": "Game translation and modification tool for players",
    "homepage": "https://mtool.app/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://trs.mtool.app/tosen.html"
    },
    "url": "https://apk.mtool.app/releases/MTool_90DDB71A.zip",
    "extract_dir": "MTool",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Tool\\fakeLocalStorage.json\")) {",
        "    Set-Content \"$dir\\Tool\\fakeLocalStorage.json\" '{}' -Encoding UTF8",
        "}"
    ],
    "shortcuts": [
        [
            "Tool\\MTool.exe",
            "MTool"
        ]
    ],
    "persist": [
        "Tool\\gameSaveBackup",
        "Tool\\gameLib",
        "Tool\\fakeLocalStorage.json"
    ],
    "notes": [
        "MTool is proprietary software.",
        "Basic features are free; advanced features require a paid license."
    ],
    "checkver": {
        "url": "https://trs.mtool.app/release.php?lang=en",
        "regex": "Latest version:\\s*(?<version>[^\\s<]+)"
    },
    "autoupdate": {
        "url": "https://apk.mtool.app/releases/MTool_$version.zip"
    }
}
