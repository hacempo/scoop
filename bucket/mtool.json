    "description": "Game translation and modification tool for players",
    "homepage": "https://mtool.app/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://trs.mtool.app/tosen.html"
    },
    "url": "https://apk.mtool.app/releases/MTool_DCEFCB13.zip",
    "hash": "f8c4d70db1c059ef6c85c1d861aa9fc670bcdeac458f11a5b8637e61a3849189",
    "extract_dir": "MTool",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\Tool\\fakeLocalStorage.json\")) {",
        "    Set-Content \"$dir\\Tool\\fakeLocalStorage.json\" '{}' -Encoding UTF8",
        "}"
    ],
    "shortcuts": [
        [
            "Tool\\MTool.exe",
            "MTool"
        ]
    ],
    "persist": [
        "Tool\\gameSaveBackup",
        "Tool\\gameLib",
        "Tool\\fakeLocalStorage.json"
    ],
    "notes": [
        "MTool is proprietary software.",
        "Basic features are free; advanced features require a paid license."
    ],
    "checkver": {
        "url": "https://trs.mtool.app/release.php?lang=en",
        "script": [
            "$page -match 'Latest version:\\s*(?<id>[A-Fa-f0-9]+)\\s+(?<timestamp>\\d+)'",
            "$id = $matches.id",
            "$zone = [TimeZoneInfo]::FindSystemTimeZoneById('Pacific Standard Time')",
            "$date = [DateTimeOffset]::FromUnixTimeSeconds([long]$matches.timestamp).UtcDateTime",
            "$timestamp = [TimeZoneInfo]::ConvertTimeFromUtc($date, $zone).ToString('yyyyMMddHHmmss', [Globalization.CultureInfo]::InvariantCulture)",
            "Write-Output \"$timestamp $id\""
        ],
        "regex": "(?<version>\\d{14}) (?<id>[A-Fa-f0-9]+)"
    },
    "autoupdate": {
        "url": "https://apk.mtool.app/releases/MTool_$matchId.zip"
    }
}
