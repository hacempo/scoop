{
    "version": "0.24.0",
    "description": "A LibVLC-based media player for Windows with video and music browsing",
    "homepage": "https://github.com/huynhsontung/Screenbox",
    "license": "GPL-3.0-only",
    "notes": [
        "Uses the upstream Screenbox sideload ZIP, which includes the MSIX bundle, signing certificate, and architecture-specific framework dependencies.",
        "This manifest supports x64 Windows only. Windows will request administrator approval to trust the signing certificate in the Local Computer Trusted People store; the app itself is installed for the current user."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/huynhsontung/Screenbox/releases/download/v0.24.0/Screenbox-sideload.zip",
            "hash": "bc0ec402830121a3bcc20b00192cc624d0732c3165ca8e240e0b97121ee52bc3"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "",
            "$bundle = Get-ChildItem -LiteralPath $dir -Filter '*.msixbundle' -File | Select-Object -First 1",
            "if (-not $bundle) {",
            "    throw 'Screenbox MSIX bundle was not found in the sideload ZIP.'",
            "}",
            "",
            "$certificateFile = Get-ChildItem -LiteralPath $dir -Filter '*.cer' -File | Select-Object -First 1",
            "if (-not $certificateFile) {",
            "    throw 'Screenbox signing certificate was not found in the sideload ZIP.'",
            "}",
            "",
            "$dependencyDirectory = Join-Path $dir 'Dependencies\\x64'",
            "if (-not (Test-Path -LiteralPath $dependencyDirectory -PathType Container)) {",
            "    throw \"Screenbox x64 dependencies were not found at '$dependencyDirectory'.\"",
            "}",
            "",
            "$vclibs = Get-ChildItem -LiteralPath $dependencyDirectory -Filter 'Microsoft.VCLibs.x64.14.00.appx' -File -Recurse | Select-Object -First 1",
            "$xaml = Get-ChildItem -LiteralPath $dependencyDirectory -Filter 'Microsoft.UI.Xaml.2.8.appx' -File -Recurse | Select-Object -First 1",
            "",
            "if (-not $vclibs) {",
            "    throw \"Microsoft.VCLibs.x64.14.00.appx was not found under '$dependencyDirectory'.\"",
            "}",
            "if (-not $xaml) {",
            "    throw \"Microsoft.UI.Xaml.2.8.appx was not found under '$dependencyDirectory'.\"",
            "}",
            "",
            "$windowsPowerShell = Join-Path $env:WINDIR 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
            "if (-not (Test-Path -LiteralPath $windowsPowerShell -PathType Leaf)) {",
            "    throw 'Windows PowerShell 5.1 was not found. It is required to install the MSIX bundle and dependencies together.'",
            "}",
            "",
            "$helperScriptPath = Join-Path $env:TEMP ('screenbox-install-' + [guid]::NewGuid().ToString('N') + '.ps1')",
            "$helperScript = @'",
            "param(",
            "    [Parameter(Mandatory = $true)][string]$BundlePath,",
            "    [Parameter(Mandatory = $true)][string]$CertificatePath,",
            "    [Parameter(Mandatory = $true)][string]$VCLibsPath,",
            "    [Parameter(Mandatory = $true)][string]$XamlPath",
            ")",
            "",
            "$ErrorActionPreference = 'Stop'",
            "$trustedPeople = 'Cert:\\LocalMachine\\TrustedPeople'",
            "$certificate = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList $CertificatePath",
            "$existingCertificate = Get-ChildItem -LiteralPath $trustedPeople | Where-Object { $_.Thumbprint -eq $certificate.Thumbprint } | Select-Object -First 1",
            "",
            "if (-not $existingCertificate) {",
            "    Write-Host 'Administrator approval is required to trust the Screenbox signing certificate.'",
            "    $escapedCertificatePath = $CertificatePath.Replace(\"'\", \"''\")",
            "    $trustCommand = @\"",
            "`$ErrorActionPreference = 'Stop'",
            "try {",
            "    `$certificate = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList '$escapedCertificatePath'",
            "    `$store = 'Cert:\\LocalMachine\\TrustedPeople'",
            "    `$existing = Get-ChildItem -LiteralPath `$store | Where-Object { `$_.Thumbprint -eq `$certificate.Thumbprint } | Select-Object -First 1",
            "    if (-not `$existing) { Import-Certificate -FilePath '$escapedCertificatePath' -CertStoreLocation `$store -ErrorAction Stop | Out-Null }",
            "    exit 0",
            "}",
            "catch { Write-Error `$_; exit 1 }",
            "\"@",
            "    $encodedTrustCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($trustCommand))",
            "    $trustProcess = Start-Process -FilePath (Join-Path $PSHOME 'powershell.exe') -Verb RunAs -Wait -PassThru -ArgumentList @('-NoLogo', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encodedTrustCommand)",
            "    if ($trustProcess.ExitCode -ne 0) {",
            "        throw \"Could not trust the Screenbox signing certificate in Local Computer\\TrustedPeople (exit code $($trustProcess.ExitCode)).\"",
            "    }",
            "}",
            "",
            "$dependencyPaths = [string[]]@($VCLibsPath, $XamlPath)",
            "",
            "Write-Host 'Installing Screenbox and its two bundled x64 dependencies...'",
            "Add-AppxPackage -Path $BundlePath -DependencyPath $dependencyPaths -ForceApplicationShutdown -ErrorAction Stop",
            "",
            "$installed = Get-AppxPackage -Name '18496Starpine.Screenbox' -ErrorAction SilentlyContinue",
            "if (-not $installed) {",
            "    throw 'Screenbox installation could not be verified.'",
            "}",
            "",
            "Write-Host \"Screenbox $($installed.Version) installed successfully.\"",
            "'@",
            "",
            "Set-Content -LiteralPath $helperScriptPath -Value $helperScript -Encoding UTF8",
            "try {",
            "    & $windowsPowerShell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $helperScriptPath -BundlePath $bundle.FullName -CertificatePath $certificateFile.FullName -VCLibsPath $vclibs.FullName -XamlPath $xaml.FullName",
            "",
            "    if ($LASTEXITCODE -ne 0) {",
            "        throw \"Screenbox installation failed in Windows PowerShell 5.1 (exit code $LASTEXITCODE).\"",
            "    }",
            "}",
            "finally {",
            "    Remove-Item -LiteralPath $helperScriptPath -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$appPackageName = '18496Starpine.Screenbox'",
            "$installedPackages = @(Get-AppxPackage -Name $appPackageName -ErrorAction SilentlyContinue)",
            "foreach ($installed in $installedPackages) {",
            "    Remove-AppxPackage -Package $installed.PackageFullName -ErrorAction Stop",
            "}",
            "$certificateFile = Get-ChildItem -LiteralPath $dir -Filter '*.cer' -File | Select-Object -First 1",
            "if ($certificateFile) {",
            "    $certificate = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList $certificateFile.FullName",
            "    $thumbprint = $certificate.Thumbprint",
            "    $userTrustedPeople = 'Cert:\\CurrentUser\\TrustedPeople'",
            "    Get-ChildItem -LiteralPath $userTrustedPeople | Where-Object { $_.Thumbprint -eq $thumbprint } | Remove-Item -ErrorAction Stop",
            "    $machineTrustedPeople = 'Cert:\\LocalMachine\\TrustedPeople'",
            "    $machineCertificate = Get-ChildItem -LiteralPath $machineTrustedPeople | Where-Object { $_.Thumbprint -eq $thumbprint } | Select-Object -First 1",
            "    if ($machineCertificate) {",
            "        Write-Host 'Administrator approval is required to remove the Screenbox signing certificate from the Local Computer store.'",
            "        $removeCommand = @\"",
            "`$ErrorActionPreference = 'Stop'",
            "try {",
            "    `$thumbprint = '$thumbprint'",
            "    `$store = 'Cert:\\LocalMachine\\TrustedPeople'",
            "    Get-ChildItem -LiteralPath `$store | Where-Object { `$_.Thumbprint -eq `$thumbprint } | Remove-Item -ErrorAction Stop",
            "    exit 0",
            "}",
            "catch { Write-Error `$_; exit 1 }",
            "\"@",
            "        $encodedRemoveCommand = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($removeCommand))",
            "        $windowsPowerShell = Join-Path $env:WINDIR 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
            "        $removeProcess = Start-Process -FilePath $windowsPowerShell -Verb RunAs -Wait -PassThru -ArgumentList @('-NoLogo', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encodedRemoveCommand)",
            "        if ($removeProcess.ExitCode -ne 0) {",
            "            throw \"Could not remove the Screenbox signing certificate from Local Computer\\TrustedPeople (exit code $($removeProcess.ExitCode)).\"",
            "        }",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/huynhsontung/Screenbox"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/huynhsontung/Screenbox/releases/download/v$version/Screenbox-sideload.zip"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/huynhsontung/Screenbox/releases/tags/v$version",
            "regex": "\"name\":\\s*\"Screenbox-sideload\\.zip\"[\\s\\S]*?\"digest\":\\s*\"sha256:([0-9a-f]{64})\""
        }
    }
}
