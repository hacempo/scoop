{
    "version": "0.24.0",
    "description": "A LibVLC-based media player for Windows with video and music browsing",
    "homepage": "https://github.com/huynhsontung/Screenbox",
    "license": "GPL-3.0-only",
    "notes": [
        "Downloads the official x64-compatible MSIX bundle directly; no sideload ZIP or development certificate is used.",
        "The package is opened with Windows App Installer. Confirm the Install button in its window to complete installation."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/huynhsontung/Screenbox/releases/download/v0.24.0/Screenbox_0.24.0.0_neutral.msixbundle",
            "hash": "6d6f03595120d6ee1042e8e7550ee2adfa3c3c6b51becbcbf454db08aee0d5cf"
        }
    },
    "installer": {
        "script": [
            "$bundle = Get-ChildItem -LiteralPath $dir -Filter '*.msixbundle' -File | Select-Object -First 1",
            "if (-not $bundle) { throw 'Screenbox MSIX bundle was not found.' }",
            "Start-Process -FilePath $bundle.FullName -Wait -ErrorAction Stop"
        ]
    },
    "uninstaller": {
        "script": [
            "$package = Get-AppxPackage -Name '18496Starpine.Screenbox'",
            "if ($package) { $package | Remove-AppxPackage -ErrorAction Stop }"
        ]
    },
    "checkver": {
        "github": "https://github.com/huynhsontung/Screenbox"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/huynhsontung/Screenbox/releases/download/v$version/Screenbox_$version.0_neutral.msixbundle"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/huynhsontung/Screenbox/releases/tags/v$version",
            "regex": "\"name\":\\s*\"Screenbox_$version\\.0_neutral\\.msixbundle\"[\\s\\S]*?\"digest\":\\s*\"sha256:([0-9a-f]{64})\""
        }
    }
}
