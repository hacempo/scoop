{
    "version": "0.24.0",
    "description": "A LibVLC-based media player for Windows with video and music browsing",
    "homepage": "https://github.com/huynhsontung/Screenbox",
    "license": "GPL-3.0-only",
    "notes": [
        "Installs the official production-signed x64 MSIX bundle with Microsoft.UI.Xaml 2.8.7 and Microsoft.VCLibs 14.0.33519.0 framework dependencies.",
        "Requires Windows 10 version 2004 (build 19041) or later.",
        "Microsoft framework downloads are SHA-256 verified and temporary files are removed after installation."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/huynhsontung/Screenbox/releases/download/v0.24.0/Screenbox_0.24.0.0_neutral.msixbundle",
            "hash": "6d6f03595120d6ee1042e8e7550ee2adfa3c3c6b51becbcbf454db08aee0d5cf"
        }
    },
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$appPackageName = '18496Starpine.Screenbox'",
            "$appVersion = [version]\"$version.0\"",
            "",
            "if ([Environment]::OSVersion.Version.Build -lt 19041) {",
            "    throw 'Screenbox requires Windows 10 version 2004 / build 19041 or later.'",
            "}",
            "",
            "$nativeArch = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }",
            "if ($nativeArch.ToUpperInvariant() -ne 'AMD64') {",
            "    throw \"This Scoop manifest installs the x64 build only. Detected architecture: $nativeArch\"",
            "}",
            "",
            "$bundle = Get-ChildItem -LiteralPath $dir -Filter '*.msixbundle' -File | Select-Object -First 1",
            "if (-not $bundle) {",
            "    throw 'The Screenbox MSIX bundle downloaded by Scoop was not found.'",
            "}",
            "",
            "$installed = Get-AppxPackage -Name $appPackageName -ErrorAction SilentlyContinue |",
            "    Sort-Object -Property Version -Descending |",
            "    Select-Object -First 1",
            "",
            "if ($installed -and ([version]$installed.Version -ge $appVersion)) {",
            "    Write-Warning \"Screenbox $($installed.Version) is already installed. No application changes are needed.\"",
            "    return",
            "}",
            "",
            "$workDir = Join-Path ([IO.Path]::GetTempPath()) ('scoop-screenbox-' + [guid]::NewGuid().ToString('N'))",
            "New-Item -ItemType Directory -Force -Path $workDir | Out-Null",
            "",
            "try {",
            "    $xamlUrl = 'https://www.nuget.org/api/v2/package/Microsoft.UI.Xaml/2.8.7'",
            "    $xamlChecksum = '79207b10fe243eb1a8dcdc29beceba2f472f145ed31f147f7ae3f43b0659c9f7'",
            "    $vclibsUrl = 'https://github.com/microsoft/winget-cli/releases/download/v1.12.350/DesktopAppInstaller_Dependencies.zip'",
            "    $vclibsChecksum = '906cad3b2be067d816b20ea4eb1df541f8a23ac4a4aa9fed70ce675cd918e6a6'",
            "",
            "    $xamlPackagePath = Join-Path $workDir 'Microsoft.UI.Xaml.2.8.7.nupkg'",
            "    $vclibsPackagePath = Join-Path $workDir 'DesktopAppInstaller_Dependencies.zip'",
            "    $xamlAppxPath = Join-Path $workDir 'Microsoft.UI.Xaml.2.8.appx'",
            "    $vclibsAppxPath = Join-Path $workDir 'Microsoft.VCLibs.x64.14.00.appx'",
            "",
            "    $curl = Join-Path $env:WINDIR 'System32\\curl.exe'",
            "    if (-not (Test-Path -LiteralPath $curl -PathType Leaf)) {",
            "        throw 'Windows curl.exe is required to download the Microsoft framework dependencies.'",
            "    }",
            "",
            "    Write-Host 'Downloading Microsoft.UI.Xaml 2.8.7...'",
            "    & $curl --location --fail --retry 3 --silent --show-error --progress-bar --output $xamlPackagePath $xamlUrl",
            "    if ($LASTEXITCODE -ne 0) {",
            "        throw \"Microsoft.UI.Xaml download failed (curl exit code $LASTEXITCODE).\"",
            "    }",
            "",
            "    $actualXamlHash = (Get-FileHash -LiteralPath $xamlPackagePath -Algorithm SHA256).Hash.ToLowerInvariant()",
            "    if ($actualXamlHash -ne $xamlChecksum) {",
            "        throw \"Microsoft.UI.Xaml checksum mismatch. Expected $xamlChecksum, got $actualXamlHash.\"",
            "    }",
            "",
            "    Write-Host 'Downloading Microsoft VCLibs framework dependencies...'",
            "    & $curl --location --fail --retry 3 --silent --show-error --progress-bar --output $vclibsPackagePath $vclibsUrl",
            "    if ($LASTEXITCODE -ne 0) {",
            "        throw \"Microsoft VCLibs download failed (curl exit code $LASTEXITCODE).\"",
            "    }",
            "",
            "    $actualVclibsHash = (Get-FileHash -LiteralPath $vclibsPackagePath -Algorithm SHA256).Hash.ToLowerInvariant()",
            "    if ($actualVclibsHash -ne $vclibsChecksum) {",
            "        throw \"Microsoft VCLibs checksum mismatch. Expected $vclibsChecksum, got $actualVclibsHash.\"",
            "    }",
            "",
            "    Add-Type -AssemblyName System.IO.Compression.FileSystem",
            "",
            "    $xamlZip = [IO.Compression.ZipFile]::OpenRead($xamlPackagePath)",
            "    try {",
            "        $xamlEntry = $xamlZip.Entries | Where-Object {",
            "            $_.FullName -match '^tools/AppX/x64/Release/Microsoft\\.UI\\.Xaml\\.2\\.8\\.appx$'",
            "        } | Select-Object -First 1",
            "",
            "        if (-not $xamlEntry) {",
            "            throw 'Microsoft.UI.Xaml 2.8.7 x64 dependency was not found in the NuGet package.'",
            "        }",
            "",
            "        [IO.Compression.ZipFileExtensions]::ExtractToFile($xamlEntry, $xamlAppxPath, $true)",
            "    }",
            "    finally {",
            "        $xamlZip.Dispose()",
            "    }",
            "",
            "    $vclibsZip = [IO.Compression.ZipFile]::OpenRead($vclibsPackagePath)",
            "    try {",
            "        $vclibsEntry = $vclibsZip.Entries | Where-Object {",
            "            $_.FullName -match '^x64/Microsoft\\.VCLibs\\.140\\.00_14\\.0\\.33519\\.0_x64\\.appx$'",
            "        } | Select-Object -First 1",
            "",
            "        if (-not $vclibsEntry) {",
            "            throw 'Microsoft.VCLibs 14.0.33519.0 x64 dependency was not found in the Microsoft dependency archive.'",
            "        }",
            "",
            "        [IO.Compression.ZipFileExtensions]::ExtractToFile($vclibsEntry, $vclibsAppxPath, $true)",
            "    }",
            "    finally {",
            "        $vclibsZip.Dispose()",
            "    }",
            "",
            "    foreach ($dependencyPath in @($xamlAppxPath, $vclibsAppxPath)) {",
            "        if (-not (Test-Path -LiteralPath $dependencyPath -PathType Leaf)) {",
            "            throw \"Extracted Microsoft framework dependency is missing: $dependencyPath\"",
            "        }",
            "    }",
            "",
            "    $dependencyPaths = @($xamlAppxPath, $vclibsAppxPath)",
            "    $appVersionString = $appVersion.ToString()",
            "",
            "    if ($PSVersionTable.PSEdition -eq 'Core') {",
            "        $windowsPowerShell = Join-Path $env:WINDIR 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
            "        if (-not (Test-Path -LiteralPath $windowsPowerShell -PathType Leaf)) {",
            "            throw 'Windows PowerShell 5.1 is required for MSIX dependency deployment because PowerShell 7 has a known Add-AppxPackage -DependencyPath array bug.'",
            "        }",
            "",
            "        $helperScriptPath = Join-Path $workDir 'Install-Screenbox.ps1'",
            "        $helperScript = @'",
            "param(",
            "    [Parameter(Mandatory = $true)][string]$BundlePath,",
            "    [Parameter(Mandatory = $true)][string]$XamlPath,",
            "    [Parameter(Mandatory = $true)][string]$VCLibsPath,",
            "    [Parameter(Mandatory = $true)][string]$AppVersion",
            ")",
            "",
            "$ErrorActionPreference = 'Stop'",
            "$dependencyPaths = @($XamlPath, $VCLibsPath)",
            "",
            "Add-AppxPackage -Path $BundlePath -DependencyPath $dependencyPaths -ForceApplicationShutdown -ErrorAction Stop",
            "",
            "$installed = Get-AppxPackage -Name '18496Starpine.Screenbox' -ErrorAction SilentlyContinue |",
            "    Sort-Object -Property Version -Descending |",
            "    Select-Object -First 1",
            "",
            "if (-not $installed -or ([version]$installed.Version -lt [version]$AppVersion)) {",
            "    throw 'Screenbox installation verification failed.'",
            "}",
            "",
            "Write-Host \"Screenbox $($installed.Version) installed successfully.\"",
            "'@",
            "        Set-Content -LiteralPath $helperScriptPath -Value $helperScript -Encoding UTF8",
            "",
            "        Write-Host 'Installing Screenbox and both Microsoft framework dependencies in one deployment operation...'",
            "        & $windowsPowerShell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $helperScriptPath -BundlePath $bundle.FullName -XamlPath $xamlAppxPath -VCLibsPath $vclibsAppxPath -AppVersion $appVersionString",
            "        if ($LASTEXITCODE -ne 0) {",
            "            throw \"Screenbox installation failed in Windows PowerShell 5.1 (exit code $LASTEXITCODE).\"",
            "        }",
            "    }",
            "    else {",
            "        Write-Host 'Installing Screenbox and both Microsoft framework dependencies...'",
            "        Add-AppxPackage -Path $bundle.FullName -DependencyPath $dependencyPaths -ForceApplicationShutdown -ErrorAction Stop",
            "    }",
            "",
            "    $installed = Get-AppxPackage -Name $appPackageName -ErrorAction SilentlyContinue |",
            "        Sort-Object -Property Version -Descending |",
            "        Select-Object -First 1",
            "",
            "    if (-not $installed -or ([version]$installed.Version -lt $appVersion)) {",
            "        throw 'Screenbox installation verification failed.'",
            "    }",
            "",
            "    Write-Host \"Screenbox $($installed.Version) installed successfully.\"",
            "}",
            "finally {",
            "    Remove-Item -LiteralPath $workDir -Recurse -Force -ErrorAction SilentlyContinue",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "$appPackageName = '18496Starpine.Screenbox'",
            "$installedPackages = @(Get-AppxPackage -Name $appPackageName -ErrorAction SilentlyContinue)",
            "if ($installedPackages.Count -eq 0) {",
            "    Write-Warning 'Screenbox is not installed for the current user.'",
            "    return",
            "}",
            "foreach ($installed in $installedPackages) {",
            "    Write-Host \"Removing Screenbox $($installed.Version)...\"",
            "    Remove-AppxPackage -Package $installed.PackageFullName -ErrorAction Stop",
            "}",
            "$remaining = @(Get-AppxPackage -Name $appPackageName -ErrorAction SilentlyContinue)",
            "if ($remaining.Count -gt 0) {",
            "    throw 'Screenbox uninstall verification failed.'",
            "}",
            "Write-Host 'Screenbox uninstalled successfully.'"
        ]
    },
    "checkver": {
        "github": "https://github.com/huynhsontung/Screenbox"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/huynhsontung/Screenbox/releases/download/v$version/Screenbox_$version.0_neutral.msixbundle"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/huynhsontung/Screenbox/releases/tags/v$version",
            "regex": "\"name\":\\s*\"Screenbox_[0-9]+\\.[0-9]+\\.[0-9]+\\.0_neutral\\.msixbundle\"[\\s\\S]*?\"digest\":\\s*\"sha256:([0-9a-f]{64})\""
        }
    }
}
