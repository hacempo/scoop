{
    "version": "0.1.4",
    "description": "跨平台中文输入法",
    "homepage": "https://github.com/qingjian-team/qingjian",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/qingjian-team/qingjian/releases/download/v0.1.4/qingjian-0.1.4-windows-x86_64-setup.exe",
            "hash": "sha256:88dbcb5562628ad09bd710fa9117804d2d671970a465c06226ea719d276adafd"
        }
    },
    "installer": {
        "script": [
            "& $fname /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /SP- /NOICONS /DIR=\"$dir\"",
            "if (-not (Test-Path (Join-Path $dir 'qingjian-server.exe'))) { throw '青简安装失败：未找到 qingjian-server.exe' }",
            "Remove-Item (Join-Path $dir 'unins000.exe') -Force -ErrorAction SilentlyContinue",
            "Remove-Item (Join-Path $dir 'unins000.dat') -Force -ErrorAction SilentlyContinue",
            "Remove-Item (Join-Path $dir 'unins000.msg') -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "Get-Process -Name 'qingjian-server' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "Get-Process -Name 'qingjian-settings' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue",
            "$dll64 = Get-ChildItem $dir -Filter 'qingjian_tsf-*.dll' | Where-Object { $_.Name -notlike '*-x86.dll' }",
            "$dll32 = Get-ChildItem $dir -Filter 'qingjian_tsf-*-x86.dll'",
            "foreach ($dll in $dll64) { & $env:WINDIR\\System32\\regsvr32.exe /u /s $dll.FullName }",
            "foreach ($dll in $dll32) { & $env:WINDIR\\SysWOW64\\regsvr32.exe /u /s $dll.FullName }"
        ]
    },
    "shortcuts": [
        [
            "qingjian-settings.exe",
            "青简设置"
        ]
    ],
    "checkver": {
        "github": "https://github.com/qingjian-team/qingjian",
        "regex": "/releases/tag/(?:windows-v|v)([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qingjian-team/qingjian/releases/download/v$version/qingjian-$version-windows-x86_64-setup.exe"
            }
        }
    }
}
