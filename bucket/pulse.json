    "architecture": {
        "64bit": {
            "url": "https://github.com/jimmgreen/pulse/releases/download/v1.0.62/PulseSetup-1.0.62.exe",
            "hash": "951b5d2a88418965638189da08a2d8fb17e53fc5a5298f4be8e5e49ed1a9e117"
        }
    },
    "installer": {
        "args": [
            "/VERYSILENT",
            "/DIR=$dir"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": "/VERYSILENT"
    },
    "checkver": {
        "url": "https://github.com/jimmgreen/pulse/releases/latest/download/update-manifest.json",
        "regex": "\"version\"\\s*:\\s*\"([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/PulseSetup-$version.exe",
                "hash": {
                    "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/update-manifest.json",
                    "regex": "\"installer_sha256\"\\s*:\\s*\"([a-fA-F0-9]{64})\""
                }
            }
        }
    }
}
