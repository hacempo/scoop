{
    "version": "1.0.56",
    "description": "为 Windows 打造的现代文件管理器",
    "homepage": "https://github.com/jimmgreen/pulse",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jimmgreen/pulse/releases/download/v1.0.56/PulseSetup-1.0.56.exe",
            "hash": "f5b8aedc128dfb8636ce19b10db83e18c5384089ea88d63fb69630bae348b9be"
        }
    },
    "installer": {
        "args": [
            "/SP-",
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART",
            "/DIR=$dir"
        ]
    },
    "uninstaller": {
        "file": "uninstall.exe",
        "args": [
            "/VERYSILENT",
            "/SUPPRESSMSGBOXES",
            "/NORESTART"
        ]
    },
    "checkver": {
        "github": "https://github.com/jimmgreen/pulse",
        "regex": "/releases/tag/v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jimmgreen/pulse/releases/download/v$version/PulseSetup-$version.exe"
            }
        }
    }
}
